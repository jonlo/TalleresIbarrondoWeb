---
import { projects } from '../data/projects';
import Placeholder from './Placeholder.astro';
const { all = false } = Astro.props;
const items = all ? projects : projects.filter(p => p.featured);
---
<section class="work-section section" aria-labelledby="work-title"><div class="container"><div class="work-heading"><div><p class="eyebrow">02 / NUESTRO TRABAJO</p><h2 id="work-title">Hecho aquí.<br />Hecho a medida.</h2></div><div><p>El metal, en todas sus formas.</p>{!all && <a class="text-link" href="/trabajos/">Explorar trabajos <span aria-hidden="true">↗</span></a>}</div></div>
<p class="gallery-notice">Estamos preparando una selección de fotografías de nuestros trabajos.</p>
<div class="project-grid">{items.map((project, i) => <figure class="project-card">{project.image ? <img src={project.image} alt={project.alt || project.title} width="800" height="650" loading="lazy" /> : <Placeholder variant={i} />}<figcaption><h3>{project.title}</h3><span class="project-index">/ 0{i + 1}</span></figcaption></figure>)}</div></div></section>

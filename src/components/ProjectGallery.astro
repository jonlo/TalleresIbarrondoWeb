---
import { Image, getImage } from 'astro:assets';
import { withBase } from '../utils/paths';
import { projects, categories } from '../data/projects';
import Arrow from './Arrow.astro';
const { all = false } = Astro.props;
const items = all ? projects : projects.filter(project => project.featured);
let photoIndex = 0;
const cards = await Promise.all(items.map(async project => {
  const start = photoIndex;
  const photos = [{ image: project.image, alt: project.alt }, ...(project.additionalPhotos || [])];
  photoIndex += photos.length;
  const entries = await Promise.all(photos.map(async photo => {
    const optimized = await getImage({ src: photo.image, width: Math.min(photo.image.width, 1800), format: 'webp', quality: 86 });
    return { src: optimized.src, alt: photo.alt, title: project.title, description: project.description, category: project.category };
  }));
  return { project, start, entries };
}));
const photos = cards.flatMap(card => card.entries);
---
<section class="work-section section" aria-labelledby="work-title" data-gallery>
  <div class="container">
    <div class="work-heading">
      <div><p class="eyebrow">02 / NUESTRO TRABAJO</p><h2 id="work-title">Hecho aquí.<br />Hecho a medida.</h2></div>
      <div><p>Metal, espacios y soluciones reales.</p>{!all && <a class="text-link" href={withBase('/trabajos/')}>Todos los trabajos <Arrow /></a>}</div>
    </div>
    <p class="gallery-notice">Una selección de nuestros trabajos. Abre una fotografía para ver los detalles.</p>
    {all && <div class="gallery-filters" aria-label="Filtrar trabajos" hidden>
      <button type="button" data-filter="todos" aria-pressed="true">Todos</button>
      {categories.map(category => <button type="button" data-filter={category.id} aria-pressed="false">{category.label}</button>)}
    </div>}
    {all && <p class="gallery-count" aria-live="polite" data-gallery-count>{items.length} trabajos</p>}
    <div class:list={['project-grid', { 'project-grid-full': all }]}>
      {cards.map(({ project, start, entries }) => <figure class="project-card" data-category={project.category}>
        <a class="project-photo" href={entries[0].src} data-photo-index={start} aria-label={`Ampliar: ${project.title}`} style={`--photo-position:${project.position}; --photo-ratio:${project.image.width < project.image.height ? '4 / 5' : '4 / 3'}`}>
          <Image src={project.image} alt={project.alt} widths={[400, 640, 960].filter(width => width <= project.image.width)} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1416px) 30vw, 424px" format="webp" quality={82} loading="lazy" />
          <span class="photo-expand"><Arrow /></span>
          {entries.length > 1 && <span class="photo-total">{entries.length} fotos</span>}
        </a>
        <figcaption><div><p class="project-category">{categories.find(category => category.id === project.category)?.label}</p><h3>{project.title}</h3></div></figcaption>
      </figure>)}
    </div>
  </div>
  <dialog class="gallery-dialog" aria-labelledby="photo-title">
    <div class="lightbox-shell">
      <div class="lightbox-toolbar"><p data-photo-count aria-live="polite"></p><button type="button" data-close aria-label="Cerrar fotografía">Cerrar <span aria-hidden="true">×</span></button></div>
      <div class="lightbox-stage"><img data-full-photo alt="" /><p class="photo-error" hidden>No se ha podido cargar la fotografía. Prueba con la siguiente.</p></div>
      <div class="lightbox-bottom"><div><h3 id="photo-title"></h3><p data-photo-description></p></div><div class="lightbox-controls"><button type="button" data-previous aria-label="Fotografía anterior">←</button><button type="button" data-next aria-label="Fotografía siguiente">→</button></div></div>
    </div>
  </dialog>
  <script type="application/json" data-photos set:html={JSON.stringify(photos).replace(/</g, '\\u003c')} />
</section>
<script>
  interface Photo { src: string; alt: string; title: string; description: string; category: string; }
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(gallery => {
    const photos: Photo[] = JSON.parse(gallery.querySelector('[data-photos]')?.textContent || '[]');
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
    const fullImage = dialog.querySelector<HTMLImageElement>('[data-full-photo]')!;
    const error = dialog.querySelector<HTMLElement>('.photo-error')!;
    const title = dialog.querySelector<HTMLElement>('#photo-title')!;
    const description = dialog.querySelector<HTMLElement>('[data-photo-description]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-photo-count]')!;
    const filterButtons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    let category = 'todos';
    let activeIndex = 0;
    let returnFocus: HTMLElement | null = null;
    let oldOverflow = '';
    const visibleIndices = () => photos.flatMap((photo, index) => category === 'todos' || photo.category === category ? [index] : []);
    function show(index: number) {
      activeIndex = index;
      const photo = photos[index];
      error.hidden = true;
      fullImage.hidden = false;
      fullImage.alt = photo.alt;
      fullImage.src = photo.src;
      title.textContent = photo.title;
      description.textContent = photo.description;
      const visible = visibleIndices();
      counter.textContent = `${visible.indexOf(index) + 1} / ${visible.length}`;
    }
    function move(direction: number) {
      const visible = visibleIndices();
      show(visible[(visible.indexOf(activeIndex) + direction + visible.length) % visible.length]);
    }
    function applyFilter(value: string, updateHash = false) {
      category = filterButtons.some(button => button.dataset.filter === value) ? value : 'todos';
      filterButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
      let count = 0;
      gallery.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
        card.hidden = category !== 'todos' && card.dataset.category !== category;
        if (!card.hidden) count++;
      });
      const resultCount = gallery.querySelector('[data-gallery-count]');
      if (resultCount) resultCount.textContent = `${count} ${count === 1 ? 'trabajo' : 'trabajos'}`;
      if (updateHash) history.replaceState(null, '', `${location.pathname}${location.search}${category === 'todos' ? '' : `#${category}`}`);
    }
    const filters = gallery.querySelector<HTMLElement>('.gallery-filters');
    if (filters) {
      filters.hidden = false;
      applyFilter(location.hash.slice(1));
      filterButtons.forEach(button => button.addEventListener('click', () => applyFilter(button.dataset.filter!, true)));
      window.addEventListener('hashchange', () => applyFilter(location.hash.slice(1)));
    }
    gallery.querySelectorAll<HTMLAnchorElement>('[data-photo-index]').forEach(link => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      returnFocus = link;
      show(Number(link.dataset.photoIndex));
      oldOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
    }));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-previous]')!.addEventListener('click', () => move(-1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => move(1));
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); move(event.key === 'ArrowLeft' ? -1 : 1); }
    });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { document.body.style.overflow = oldOverflow; returnFocus?.focus(); });
    fullImage.addEventListener('error', () => { fullImage.hidden = true; error.hidden = false; });
    let start: { x: number; y: number } | null = null;
    fullImage.addEventListener('touchstart', event => { start = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null; }, { passive: true });
    fullImage.addEventListener('touchcancel', () => { start = null; });
    fullImage.addEventListener('touchend', event => {
      if (!start || !event.changedTouches.length) return;
      const dx = event.changedTouches[0].clientX - start.x;
      const dy = event.changedTouches[0].clientY - start.y;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) move(dx < 0 ? 1 : -1);
      start = null;
    }, { passive: true });
  });
</script>

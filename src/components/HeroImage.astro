---
import { Image } from 'astro:assets';
import structure from '../assets/projects/estructura-forjado.jpg';
---
<figure class="hero-image">
  <Image src={structure} alt="Trabajo de Talleres Ibarrondo: estructura de vigas de acero y chapa perfilada para un forjado." widths={[480, 768, 1200]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1416px) 45vw, 640px" format="webp" quality={84} loading="eager" fetchpriority="high" style="object-position: 50% 28%" />
  <figcaption>ESTRUCTURAS METÁLICAS <span>Fabricación y montaje</span></figcaption>
</figure>
